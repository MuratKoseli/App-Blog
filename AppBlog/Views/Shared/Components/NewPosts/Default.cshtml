@model List<Post>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="card-title">New Posts</h5>
    </div>
    <div class="cord-body">
        @foreach (var post in Model)
        {
            <div class="mb-3">
                <h6 class="mb-0" style="padding-left: 10px;">
                    <a href="/posts/details/@post.Url">@post.Title</a>
                </h6>
            </div>
        }
    </div>
</div>